{
  "name": "shyam-salim-learn-ml",
  "version": "0.1.0",
  "private": true,
  "description": "Do dost. Ek chai. Aur Machine Learning. An immersive, story-driven ML learning platform built as conversations between Shyam and Salim.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "seed": "DOTENV_CONFIG_PATH=.env.local tsx scripts/seed.ts",
    "seed:admin": "DOTENV_CONFIG_PATH=.env.local tsx scripts/seed-admin.ts",
    "validate": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "@mui/material": "6.4.0",
    "@mui/icons-material": "6.4.0",
    "@mui/material-nextjs": "9.4.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.0",
    "@emotion/cache": "11.14.0",
    "mongodb": "6.12.0",
    "zod": "3.24.1",
    "react-hook-form": "7.54.2",
    "@hookform/resolvers": "3.9.1",
    "framer-motion": "11.18.0",
    "jose": "5.9.6",
    "@node-rs/argon2": "2.0.2",
    "sanitize-html": "2.14.0",
    "react-markdown": "9.0.3",
    "remark-gfm": "4.0.0",
    "rehype-sanitize": "6.0.0",
    "slugify": "1.6.6",
    "date-fns": "4.1.0",
    "nanoid": "5.0.9",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "@types/node": "22.10.5",
    "@types/react": "19.0.6",
    "@types/react-dom": "19.0.2",
    "@types/sanitize-html": "2.13.0",
    "eslint": "9.18.0",
    "eslint-config-next": "15.1.6",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.4.2",
    "vitest": "2.1.8",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "2.1.8",
    "jsdom": "25.0.1",
    "@testing-library/react": "16.1.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/user-event": "14.5.2",
    "@playwright/test": "1.49.1",
    "tsx": "4.19.2",
    "dotenv": "16.4.7"
  }
}
