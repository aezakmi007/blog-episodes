# ---------------------------------------------------------------------------
# Shyam & Salim Learn ML — environment configuration
# Copy this file to .env.local for local development and fill in real values.
# Never commit .env.local or any file containing real secrets.
# All variables are validated at startup by src/lib/env.ts (see that file for
# the exact rules). The app will refuse to boot if a required variable is
# missing or malformed.
# ---------------------------------------------------------------------------

# MongoDB connection string (Atlas or self-hosted). Must include a database
# name in the path, e.g. mongodb+srv://user:pass@cluster/shyam_salim_learn_ml
MONGODB_URI=mongodb://127.0.0.1:27017/shyam_salim_learn_ml

# Public base URL of the deployed app (no trailing slash). Used for
# canonical URLs, sitemap generation and Open Graph metadata.
APP_URL=http://localhost:3000

# Secret used to sign admin session tokens (JWT/JWE). Generate with:
#   openssl rand -base64 48
# Must be at least 32 characters. Rotating this value invalidates all
# existing admin sessions.
AUTH_SECRET=replace-with-a-long-random-value-at-least-32-characters

# Bootstrap admin credentials. Consumed ONLY by `npm run seed:admin`, a
# one-time CLI command — never read by the running application server.
# The password is never printed or logged by the seed script.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password-before-running-seed

# Node environment: development | test | production
NODE_ENV=development
